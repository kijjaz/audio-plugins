// ============================================================================
// VRC6 8-Bit Overdrive Wrap Saw (96 kHz, 24-bit)
// ============================================================================
<global>
ampeg_attack=0.001
ampeg_decay=0.0
ampeg_sustain=100
ampeg_release=0.040

<group>
loop_mode=loop_continuous
amp_veltrack=100
<region> sample=samples/waveforms/vrc6_saw_overdrive_C1.wav lokey=24 hikey=25 pitch_keycenter=24 loop_start=40490 loop_end=125620
