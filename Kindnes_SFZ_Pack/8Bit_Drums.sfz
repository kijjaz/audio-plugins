// ============================================================================
// Kindnes Comprehensive 8-Bit Vintage 1-Bit Drum & SFX Sound Library (96kHz 24-bit)
// 61 Chromatic Voices: Notes 24 to 84 (C1 to C6)
// ============================================================================
<global>
amp_veltrack=95
