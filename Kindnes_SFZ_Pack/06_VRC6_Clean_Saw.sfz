// ============================================================================
// VRC6 14-Step Clean Sawtooth (96 kHz, 24-bit)
// ============================================================================
<global>
ampeg_attack=0.001
ampeg_decay=0.0
ampeg_sustain=100
ampeg_release=0.040

<group>
loop_mode=loop_continuous
amp_veltrack=100
