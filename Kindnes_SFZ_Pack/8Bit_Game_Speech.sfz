// ====================================================================
// Kindnes 8-Bit Vintage Arcade Game Speech Library (96kHz, 24-bit)
// Cycle-accurate 1-Bit DPCM Delta Modulation & Hardware Speech Silicon
// Key Range: C3 (Note 48) - B5 (Note 83) across 36 chromatic pads
// ====================================================================

<control>
default_path=samples/speech/

<global>
loop_mode=one_shot
ampeg_attack=0.001
ampeg_decay=0.0
ampeg_sustain=100
ampeg_release=0.1

// Note 48: Game start! (Start)
<region>
sample=01_Game_Start.wav
key=48
pitch_keycenter=48

// Note 49: Ready... Go! (Start)
<region>
sample=02_Ready_Go.wav
key=49
pitch_keycenter=49

